{
  "headers": [
    {
      "source": "/(admin|aluno)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(login|register|criar-conta|recuperar-senha|redefinir-senha|checkout)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(auth|checkout)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/social-preview-1200x630.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/seo-html" },
    { "source": "/materiais", "destination": "/api/seo-html" },
    { "source": "/suporte", "destination": "/api/seo-html" },
    { "source": "/explicacoes", "destination": "/api/seo-html" },
    { "source": "/sobre", "destination": "/api/seo-html" },
    { "source": "/privacidade", "destination": "/api/seo-html" },
    { "source": "/cookies", "destination": "/api/seo-html" },
    { "source": "/termos-de-uso", "destination": "/api/seo-html" },
    { "source": "/sitemap.xml", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=sitemap" },
    { "source": "/robots.txt", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=robots" },
    { "source": "/llms.txt", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=llms" },
    { "source": "/favicon", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset?branding_role=favicon" },
    { "source": "/api/public/site-asset", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset" },
    { "source": "/api/public/course-media", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-course-media" },
    { "source": "/api/public/profile-avatar", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-profile-avatar" },
    { "source": "/api/public/request-free-download", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/request-free-download" },
    { "source": "/api/public/redeem-free-download", "destination": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/redeem-free-download" },
    { "source": "/((?!api/|assets/|favicon|favicon.ico|index.html|manifest.webmanifest|sw.js|offline.html|sitemap.xml|robots.txt|llms.txt|icons/|social-preview-1200x630.jpg).*)", "destination": "/" }
  ]
}
