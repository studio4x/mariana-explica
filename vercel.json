{
  "headers": [
    {
      "source": "/(admin|aluno)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(login|register|criar-conta|recuperar-senha|redefinir-senha|checkout)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(auth|checkout)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/social-preview-1200x630.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "routes": [
    { "src": "^/sitemap\\.xml$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=sitemap" },
    { "src": "^/robots\\.txt$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=robots" },
    { "src": "^/llms\\.txt$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=llms" },
    { "src": "^/(favicon\\.ico|favicon\\.svg|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png|icon-app\\.svg|icon-maskable\\.svg)$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset?branding_role=favicon" },
    { "src": "^/favicon$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset?branding_role=favicon" },
    { "src": "^/site-asset$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset" },
    { "src": "^/api/public/site-asset(?:/(.*))?$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset" },
    { "src": "^/api/public/course-media(?:/(.*))?$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-course-media" },
    { "src": "^/api/public/profile-avatar(?:/(.*))?$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-profile-avatar" },
    { "src": "^/api/public/request-free-download(?:/(.*))?$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/request-free-download" },
    { "src": "^/api/public/redeem-free-download(?:/(.*))?$", "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/redeem-free-download" },
    { "src": "^/social-share-image\\.jpg$", "dest": "/api/social-image" },
    { "src": "^/social-image$", "dest": "/api/social-image" },
    { "src": "^/api/(.*)$", "continue": true },
    { "src": "^/index\\.html$", "continue": true },
    { "src": "^/(?!assets/|api/|favicon$|favicon\\.ico$|index\\.html$|manifest\\.webmanifest$|sw\\.js$|offline\\.html$|sitemap\\.xml$|robots\\.txt$|llms\\.txt$|icons/|site-asset$|social-image$|social-share-image\\.jpg$|social-preview-1200x630\\.jpg$).*$", "dest": "/api/seo-html" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/" }
  ]
}
