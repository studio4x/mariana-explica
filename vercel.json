{
  "headers": [
    {
      "source": "/(admin|aluno)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(login|register|criar-conta|recuperar-senha|redefinir-senha|checkout)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(auth|checkout)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, stale-while-revalidate=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=sitemap"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=robots"
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-seo-files?file=llms"
    },
    {
      "src": "^/api/public/site-asset(?:/(.*))?$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-site-asset"
    },
    {
      "src": "^/api/public/course-media(?:/(.*))?$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-course-media"
    },
    {
      "src": "^/api/public/profile-avatar(?:/(.*))?$",
      "dest": "https://gookhgufsxeplelpdaua.supabase.co/functions/v1/public-profile-avatar"
    },
    {
      "src": "^/api/(.*)$",
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "continue": true
    },
    {
      "src": "^/(?!assets/|api/|favicon\\.ico$|index\\.html$|manifest\\.webmanifest$|sw\\.js$|offline\\.html$|sitemap\\.xml$|robots\\.txt$|llms\\.txt$|icons/).*$",
      "dest": "/api/seo-html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/"
    }
  ]
}
